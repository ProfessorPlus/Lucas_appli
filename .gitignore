# =========================
# 🔐 SECRETS & CONFIG
# =========================
secrets.yaml
*_secrets.yaml
*.env
.streamlit/secrets.toml
config/*.yaml

# =========================
# 📁 DONNÉES GÉNÉRÉES
# =========================
data/
Factures/
invoice_counters/
# JSON dans dossiers de données — pas un blanket *.json (sinon ça ignore
# aussi tsconfig.json, .vscode/*.json, etc., et Vercel n'arrive plus à
# résoudre les path aliases dans le frontend Next.js).
data/*.json
invoice_counters/**/*.json
*.local.json
# Google service account JSON (sensible, ne JAMAIS commit)
google_service_account.json
google_service_account.json.json
config/google_service_account.json
**/google_service_account*.json

# =========================
# 🐍 PYTHON
# =========================
__pycache__/
*.py[cod]
*.so
*$py.class
.Python
build/
dist/
.eggs/
*.egg-info/

# =========================
# 🧪 ENVIRONNEMENTS
# =========================
.venv/
venv/
env/
ENV/

# =========================
# 🖥️ IDE / OS
# =========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =========================
# 📜 LOGS
# =========================
*.log
config/secrets_no_prof.yaml

# =========================
# 📦 NODE / NEXT.JS (frontend)
# =========================
node_modules/
.next/
out/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts

# =========================
# 🗃️ BACKEND PERSISTENCE
# =========================
backend/jobs.db
backend/jobs.db-journal
backend/.env
backend/.venv/

# yaml_io auto-backups (created on every write_yaml)
*.yaml.prev
*.local-backup.yaml

# Frontend env files (Next.js — never commit secrets or API keys)
.env.local
.env.development.local
.env.test.local
.env.production.local

